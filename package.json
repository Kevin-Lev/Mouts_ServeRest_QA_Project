{
  "name": "mouts_serverest_qa_project",
  "version": "1.0.0",
  "description": "Implementação de testes automatizados na API e frontend da aplicação ServeRest com a linguagem JavaScript e o framework Cypress",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser firefox",
    "cy:run:api": "cypress run --browser firefox --spec 'cypress/e2e/api/**/*.js'",
    "cy:run:frontend": "cypress run --browser firefox --spec 'cypress/e2e/frontend/**/*.cy.js'",
    "cy:run:frontend:video": "cypress run --browser firefox --config video=true --spec 'cypress/e2e/frontend/**/*.cy.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevin-Lev/Mouts_ServeRest_QA_Project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Kevin-Lev/Mouts_ServeRest_QA_Project/issues"
  },
  "homepage": "https://github.com/Kevin-Lev/Mouts_ServeRest_QA_Project#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-cypress": "^7.2.0",
    "prettier": "^3.10.1"
  }
}
